# Example environment for running the HOS01 A2A agent with Gemini 2.0 Flash
# Copy this file to `.env` and fill in real secrets/paths before running.

# Server
PORT=8080
ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Authentication options
# Option A — API key (quick local dev): set `GOOGLE_API_KEY` and use the api_key auth method
GOOGLE_API_KEY=your_api_key_here
ADK_AUTH_METHOD=api_key

# Option B — Service account (recommended for server deployments): uncomment and set path
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# ADK_AUTH_METHOD=service_account

# ADK / model settings
ADK_MODEL=gemini-2.0-flash
ADK_RUN_MODE=web
ADK_AGENT_CARD_PATH=.well-known/agent.json

# A2A exposure toggles (if you intend to run adk in A2A mode)
A2A_ENABLE=true
A2A_CLIENT_ID=your-a2a-client-id
A2A_CLIENT_SECRET=your-a2a-client-secret

# Logging
LOG_LEVEL=info
